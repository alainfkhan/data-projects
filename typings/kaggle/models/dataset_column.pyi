from _typeshed import Incomplete

class DatasetColumn:
    column_types: Incomplete
    attribute_map: Incomplete
    discriminator: Incomplete
    def __init__(
        self, order=None, name=None, type=None, original_type=None, description=None
    ) -> None: ...
    @property
    def order(self): ...
    @order.setter
    def order(self, order) -> None: ...
    @property
    def name(self): ...
    @name.setter
    def name(self, name) -> None: ...
    @property
    def type(self): ...
    @type.setter
    def type(self, type) -> None: ...
    @property
    def original_type(self): ...
    @original_type.setter
    def original_type(self, original_type) -> None: ...
    @property
    def description(self): ...
    @description.setter
    def description(self, description) -> None: ...
    def to_dict(self): ...
    def to_str(self): ...
    def __eq__(self, other): ...
    def __ne__(self, other): ...
